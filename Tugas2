#include <iostream>
using namespace std;

struct node{
    int data;
    node* next;
    node(int isi){
        data= isi;
        next= nullptr;
    }
};

node* head= nullptr;
node* tail= nullptr;

void tambahDepan(int isi){
    node* baru = new node(isi);
    baru->next= head;
    head= baru;
    if (tail== nullptr){
        tail= baru;
    }
}

void tambahBelakang(int isi){
    node* baru= new node(isi);
    if (head== nullptr){
        head= baru;
        tail= baru;
    } else {
        tail->next= baru;
        tail= baru;
    }
}

void tampilkan(){
    node* temp= head;
    while (temp != nullptr){
        cout<< temp->data<<" ";
        temp= temp->next;
    }
    cout<<endl;
}

